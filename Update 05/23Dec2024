# Get the individual claims triangle
def GetIndividualClaimsTriangle(older_claims_transactions, val_date, latest_dpi_of_transaction_for_each_old_claim, older_claims_numbers, open_claim_number, valuation_dat, weighted_cum_claims_rectangle):
    
    # list to store the individual claims triangle as the elements will be of differing lengths
    individual_claims_triangle = []   

    # Obtaining the latest dpi for each old claim as at the valuation date
    latest_dpi_for_each_old_claim = GetTheLatestDPAtValuationDate(older_claims_transactions, GetStatusOfOlderTransactions(older_claims_transactions, val_date), latest_dpi_of_transaction_for_each_old_claim, val_date)

    # Obtaining the individual cumulative claims "triangle"
    for claim in range(len(older_claims_numbers)):
        
        # selects development periods from the development period the open claim has developed up to 
        # selects development periods up to the last development period in which there was a transaction for each claim
        temp = weighted_cum_claims_rectangle[claim,  GetDPForOpenClaimAtValuationDate(valuation_dat, open_claim_number, val_date):int(latest_dpi_for_each_old_claim[claim])]
        #print(temp)
        individual_claims_triangle.append(temp)

    #print("This is the individual claims triangle: ", individual_claims_triangle)
    return(individual_claims_triangle)

#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
def GetTheLinkRatiosForAnOpenClaim(older_claims_transactions, individual_claims_triangle, latest_transaction_dpi_for_old_claims, val_date, valuation_dat, open_claim_number):

    old_claim_status = GetStatusOfOlderTransactions(older_claims_transactions, val_date)
    dev_period_index_at_valuation_date_for_open_claim = GetDPForOpenClaimAtValuationDate(valuation_dat, open_claim_number, val_date)

    # This is how many development factors we are going to need to generate
    projection_period = int(max(GetTheLatestDPAtValuationDate(older_claims_transactions, old_claim_status, latest_transaction_dpi_for_old_claims, val_date)) - dev_period_index_at_valuation_date_for_open_claim)

    link_ratios = np.zeros((projection_period - 1))

    #print("This is the individual claims triangle: ", individual_claims_triangle)
    #print("This is indexing the first element of the individual claims triangle: ", len(individual_claims_triangle[0]))

    # Subsetting the individual claims triangle to only claims that are of a certain length 
    # dpi iterates over 1:projection period to obtain the link ratio for each development period
    for dpi in range(projection_period): 

        # Subset to obtain the claims that are relevant to each development period 
        small = [x for x in individual_claims_triangle if (len(x) if type(x) != int else 1) > (dpi + 1)]
        
        if (len(small) > 0):

            # Select the correct column to add
            first_col = [i[dpi] for i in small]       
            second_col = [i[dpi+1] for i in small]

            # Sum the values in each development period
            # d is for the denominator of the link ratio
            # n is for the numerator of the link ratio
            d = sum(first_col)
            n = sum(second_col)

            # Calculating the link ratio
            link_ratios[dpi] = n/d
        else:
            assert len(small) == 0

    return(link_ratios)

#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Predict the open claims using the link ratios
def GetPredictionForOpenClaim(open_rectangle_claim, link_ratios):

    # This is the last observed development period for the claim
    last_observed_dp = len(open_rectangle_claim)

    # Converting the numpy array to a list in order to append predicted development period values
    open_rectangle_claim = open_rectangle_claim.tolist()

    for link in range(len(link_ratios)):
        next_period_prediction = open_rectangle_claim[last_observed_dp - 1 + link] * link_ratios[link]
        open_rectangle_claim.append(next_period_prediction)

    # Converting back to numpy array for ease of use 
    open_rectangle_claim = np.array(open_rectangle_claim)

    return(open_rectangle_claim)

