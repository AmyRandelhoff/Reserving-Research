# Obtaining the weighted cumulative claims triangle
def GetWeightedCumulativeClaimsTriangle(cum_claims_rectangle, older_longer_claims, weights):

    # Created to store the weighted cumulative claims rectangle, where the weights are calculated in the GetWeightsForSimilarity function
    # The type of this a numpy.ndarray 
    weighted_cum_claims_rectangle = np.zeros((len(cum_claims_rectangle), len(cum_claims_rectangle[0])))

    #print("This is the cumulative claims rectangle: ", cum_claims_rectangle)
    #print(cum_claims_rectangle[0])

    # Obtaining the weighted cumulative claims rectangles
    for claim in range(len(older_longer_claims)):
        weighted_cum_claims_rectangle[claim] = cum_claims_rectangle[claim] * weights[claim]

    #print("This is the weighted cumulative claims rectangle: ", weighted_cum_claims_rectangle)
    #print("This is the type of the weighted cumulative claims triangle: ", type(weighted_cum_claims_rectangle))

    return(weighted_cum_claims_rectangle)

