# Get the development period index for the open claim at the valuation date
def GetDPForOpenClaimAtValuationDate(valuation_dat, open_claim_number, val_date):

    # Obtaining the open claim data from open claim number
    open_claim_transactions = valuation_dat[valuation_dat["claim_no"] == open_claim_number]
    open_claim = open_claim_transactions.iloc[0, :]

    # Development period of the open claim at the valuation date
    dev_period_at_valuation_date_for_open_claim = (val_date.year - open_claim["NewOriginYear"]) * 12 + val_date.month - open_claim["NewOriginMonth"] + 1
    # Python indexes from 0
    dev_period_index_at_valuation_date_for_open_claim = dev_period_at_valuation_date_for_open_claim - 1 

    return(dev_period_index_at_valuation_date_for_open_claim)

