# Applying the new model 
def ApplyIndividualClaimsReservingModel(val_dat):

    # Step 1: Get the time all claims have been open
    ClaimsListWithTimeOpen = GetTimeClaimHasBeenOpen(val_dat)

    # Step 2: Get the open claims at the valuation date
    open_claims = GetListOfOpenClaimsAtValuationDate(val_dat)
    #print("This is the open claim")
    #test_open_claim_number = open_claims[0]
    #print(test_open_claim)

    # Create list to store developed claims predictions
    results_individual_claims_model = []

    # Create list to store claims which cannot be predicted because there are no older or longer claims
    no_older_longer_claims = []

    for claim in range(len(open_claims)):

        open_claim = open_claims[claim]
        print("This is the open claim number: ", open_claim)

        # Step 3: Find the claims that have been open longer than the current claim
        older_claims = GetListOfOlderandLongerTailClaims(open_claim, ClaimsListWithTimeOpen)
        #print(type(older_claims))

        if(len(older_claims) > 0):

            # Step 4: Find the transactions related to the older claims
            older_claims_transactions = val_dat[val_dat["claim_no"].isin(older_claims)]
            #print("These are the older claims transactions")
            #print(older_claims_transactions)

            # Step 5: Convert the data frame of transactions into a cumulative claims rectangle
            closed_rectangle = GetCumulativeIndividualClaimsRectangle(older_claims_transactions)
            #print("This is the cumulative claims rectangle for the older claims")
            #print(rectangle)

            # Step 6: Find the transactions related to the open claim
            open_claim_transactions = valuation_dat[valuation_dat["claim_no"].isin(open_claims)]

            # Step 7: Get the cumulative claims triangle for the open claims
            open_rectangle = GetCumulativeIndividualClaimsRectangle(open_claim_transactions)
            #print("This is the open claims triangle")
            #print(open_rectangle)

            # Step 8: Get the features for calculating the Euclidean distance - old claims transactions
            older_claims_features = GetFeaturesForCalculatingEuclideanDistance(older_claims_transactions)
            #print(older_claims_features)

            # Step 9: Get the features for calculating the Euclidean distance - open claims transactions
            open_claims_features = GetFeaturesForCalculatingEuclideanDistance(open_claim_transactions)
            open_claim_features = open_claims_features[0].iloc[claim,:]
            open_claim_month = open_claims_features[1].iloc[claim]
            #print("These are the open claims features:")
            #print(open_claims_features)

            # Step 10: get the weights for the similarity using the Euclidean distances calculated
            weights = GetWeightsForSimilarityUsingEuclideanDistance(open_claim_features, open_claim_month, older_claims_features[0], older_claims_features[1])
            #print("These are the weights: ")
            #print(weights)

            # Step 11: Obtaining the weighted cumulative claims rectangle
            weighted_cum_claims_rectangle = GetWeightedCumulativeClaimsTriangle(closed_rectangle[0], older_claims, weights)
            #print(weighted_cum_claims_rectangle)

            # Step 12: Get the individual claims triangle
            individual_claims_triangle = GetIndividualClaimsTriangle(older_claims_transactions, val_date, closed_rectangle[1], older_claims, open_claim, valuation_dat, weighted_cum_claims_rectangle)
            #print("This is the individual claims triangle: ", individual_claims_triangle)

            # Step 13: Determining the link ratio by applying weights to older and longer tailed claims
            link_ratios = GetTheLinkRatiosForAnOpenClaim(older_claims_transactions, individual_claims_triangle, closed_rectangle[1], val_date, valuation_dat, open_claim)
            #print(link_ratios)

            # Step 14: Use the link ratio to predict the rest of the claim
            open_rectangle_claims_rectangle = open_rectangle[0]
            open_rectangle_claim = open_rectangle_claims_rectangle[claim]
            open_claims_prediction = GetPredictionForOpenClaim(open_rectangle_claim, link_ratios)

            results_individual_claims_model.append(open_claims_prediction)
            #print(open_claims_prediction)
        
        else:
                assert len(older_claims) == 0
                no_older_longer_claims.append(open_claim)


    return(results_individual_claims_model, no_older_longer_claims)
    
