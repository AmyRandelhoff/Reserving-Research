# Determine if older transactions are closed or open
def GetStatusOfOlderTransactions(older_claims_transactions, val_date):
    old_claim_status = pd.DataFrame(older_claims_transactions.claim_no.unique())
    close_date = older_claims_transactions.groupby("claim_no", sort = False)["close_date"].max().to_list()
    old_claim_status["max_close_date"] = close_date

    old_claim_status["claim_status"] = np.nan
    
    for claim in range(len(old_claim_status)):
        if (old_claim_status.iloc[claim, 1] > val_date):
            old_claim_status["claim_status"] = "Open"
        else:
            old_claim_status["claim_status"] = "Closed"

    return(old_claim_status)
#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Determine the latest development period of each older claim as at the valuation date 
# For open claims, the latest development period will be the difference between the valuation date and the origin date of the claim
# For closed claimes, the latest development period will be the last transaction date (which should also be the closing date)

def GetTheLatestDPAtValuationDate(older_claims_transactions, old_claim_status, latest_transaction_dpi_for_old_claims, val_date):

    new_origin_year = older_claims_transactions.groupby("claim_no", sort = False)["NewOriginYear"].max().to_list()
    new_origin_month = older_claims_transactions.groupby("claim_no", sort = False)["NewOriginMonth"].max().to_list()

    for claim in range(len(old_claim_status)):
        
        if(old_claim_status.iloc[claim, 2] == "Open"):
            latest_transaction_dpi_for_old_claims[claim] = (val_date.year - new_origin_year[claim]) * 12 + val_date.month - new_origin_month[claim] + 1
        
        else:
            assert latest_transaction_dpi_for_old_claims[claim] == latest_transaction_dpi_for_old_claims[claim]
    
    #print("This is the latest transaction dpi: ", latest_transaction_dpi_for_old_claims)
    return(latest_transaction_dpi_for_old_claims)

