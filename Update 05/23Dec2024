# Determining the features used to calculate the similarity (Euclidean distance) between claims
def GetFeaturesForCalculatingEuclideanDistance(dat):

    # Reporting delay
    neworigintoreportdays = (dat["report_date"] - dat["new_origin_date"]).dt.days

    # Case estimates
    dat["index"] = pd.RangeIndex(len(dat.index))
    indices = dat.groupby("claim_no")["index"].min().to_list()
    indices = sorted(indices)
    unique_claim_dat = dat.iloc[indices,]
    unique_claim_dat["CaseEstimates"] = unique_claim_dat["incurred_inc"]

    features  = unique_claim_dat[["claim_no", "CaseEstimates"]]

    # One-hot encoding of the categorical variables
    # Class
    dummies_class = pd.get_dummies(unique_claim_dat.Class, dtype = int)
    dummies_class.columns = ["Class1", "Class2", "Class3"]
    # Region
    dummies_region = pd.get_dummies(unique_claim_dat.Region, dtype = int)
    dummies_region.columns = ["Region1", "Region2", "Region3"]
    # Type
    dummies_type = pd.get_dummies(unique_claim_dat.Type, dtype = int)
    dummies_type.columns = ["Type1", "Type2", "Type3"]
    
    features_dat = pd.concat([features, neworigintoreportdays, dummies_class, dummies_region, dummies_type], axis=1)
    
    transaction_months = unique_claim_dat["TransactionMonth"]

    print(features_dat)
    print(transaction_months)

    # Sclaing the features so that no feature has undue influence on the similarity score
    # Initialise the Scaler
    scaler = StandardScaler()

    # To scale data
    scaler.fit(features_dat)
    scaler.fit(transaction_months)

    print(features_dat)
    print(transaction_months)

    return(features_dat, transaction_months)

#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 # Function for the weighted Euclidean distance
def weightedSum(claim, num_features):
    # Adding 1 to the number of features to account for the months feature
    weights = np.repeat(a = 1, repeats = (num_features + 1))
    dist = (sum(claim * weights))**(1/2)
    return(dist)
    
#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Determining the weights for the older and longer tailed claims
def GetWeightsForSimilarityUsingEuclideanDistance(open_claim_features, open_claim_trans_month, feature_dat, transaction_months):

    # Storing the number of features used excluding the months feature
    num_features = len(feature_dat.columns)
    #print("This is the number of features: ", num_features)

    # Determine the Euclidean distance for all features except month
    # Setting up an empty matrix to store the output of the for loop
    claims_features = np.zeros((len(feature_dat), num_features))

    # Determining the Euclidean distance between each claim for the numerical feature
    for claim in range(len(feature_dat)): 
        claims_features[claim, : ] = (open_claim_features.iloc[range(len(feature_dat.columns))] - feature_dat.iloc[claim, range(len(feature_dat.columns))])**2

    #print("This is the claim features: ", len(claims_features))

    # Determine the distance for the month of transaction - uses a different formula as the months are not one hot encoded
    # Setting up an empty matrix to store the output of the for loops
    months_dist = np.zeros((len(transaction_months), 1))

    # Determining the distance measure for the month of transaction
    for claim in range(len(transaction_months)): 
        #print(abs(open_claim_trans_month - transaction_months.iloc[claim])) 
        #print(12 - abs(open_claim_trans_month - transaction_months.iloc[claim]))
        months_dist[claim] = min(abs(open_claim_trans_month - transaction_months.iloc[claim]), 12 - abs(open_claim_trans_month - transaction_months.iloc[claim]))

    # Storing the features from the features dataset and the month feature in one array 
    claims_features = np.column_stack([claims_features, months_dist])

    # Creating a numpy array to store the euclidean distance in 
    euclidean_dist = np.zeros((len(feature_dat)))

    # Finding the Euclidean distance with all features
    for claim in range(len(feature_dat)):
        current_claim = claims_features[claim, : ]
        euclidean_dist[claim] = weightedSum(current_claim, num_features)

    euclidean_dist = euclidean_dist.astype(np.float64)
    weights = np.reciprocal(euclidean_dist)
    scale_factor = sum(weights)
    weights = weights * 1/scale_factor

    return(weights)

